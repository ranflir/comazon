// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid()) //attribute 필드에 대한 추가정보
  email     String @unique
  firstName String
  lastName  String
  address   String // ? NULL  nullable컬럼
  //shift + alt + F -> 자동포맷팅
  createdAt DateTime @default(now()) //거의 모든 모델에 들어간다
  updatedAt DateTime @updatedAt
}

